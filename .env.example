# Supabase Configuration (Optional - falls back to local storage if omitted)
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# AI PROVIDER & MODEL CONFIGURATION
# Supported providers: mistral (default), gemini, openai, groq, openrouter, mock
# ==============================================================================
VITE_AI_PROVIDER=mistral

# ------------------------------------------------------------------------------
# 1. MISTRAL AI CONFIGURATION (Active Default)
# Get your API key from Mistral AI Console: https://console.mistral.ai/api-keys/
# ------------------------------------------------------------------------------
VITE_MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral Model (default: mistral-small-latest)
# Recommended options:
# - mistral-small-latest (fastest & high quality, best for video scripts)
# - mistral-large-latest (highest reasoning capabilities)
# - open-mistral-nemo (open-weight, very high token limits)
# - codestral-latest (specialized for technical / coding scripts)
# Note: If rate limits (429) are hit, ScriptFlow automatically cascades to backup models.
VITE_MISTRAL_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI CONFIGURATION (Optional - Switch with VITE_AI_PROVIDER=gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. UNIVERSAL / ANY OPENAI-COMPATIBLE PROVIDER (Optional)
# Works for OpenAI, Groq, OpenRouter, DeepSeek, or local Ollama / vLLM
# ------------------------------------------------------------------------------
# VITE_AI_API_KEY=
# VITE_AI_MODEL=
# VITE_AI_BASE_URL=

# ------------------------------------------------------------------------------
# Analytics (Optional)
# ------------------------------------------------------------------------------
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
